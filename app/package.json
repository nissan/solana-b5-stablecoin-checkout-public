{
  "name": "stablecoin-checkout",
  "description": "Stablecoin checkout: Next.js, @solana/pay, @solana/kit",
  "keywords": [
    "solana-pay",
    "solana-kit",
    "nextjs",
    "stablecoin"
  ],
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "next build",
    "ci": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "dev": "next dev",
    "devnet:audd": "node scripts/devnet-audd.mts",
    "devnet:helius-webhook": "node scripts/devnet-helius-webhook.mts",
    "devnet:merchant-account": "node scripts/devnet-merchant-account.mts",
    "devnet:pay": "node scripts/devnet-pay.mts",
    "devnet:reproduce": "node scripts/devnet-reproduce.mts",
    "devnet:verify-payment": "node scripts/devnet-verify-payment.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana-program/memo": "^0.16.0",
    "@solana-program/system": "^0.16.0",
    "@solana-program/token": "^0.18.0",
    "@solana-program/token-2022": "^0.20.0",
    "@solana/keys": "^8.6.0",
    "@solana/kit": "^8.6.0",
    "@solana/kit-plugin-instruction-plan": "^0.19.0",
    "@solana/kit-plugin-rpc": "^0.22.0",
    "@solana/kit-plugin-signer": "^0.19.0",
    "@solana/kit-plugin-wallet": "^0.20.0",
    "@solana/pay": "file:./vendor/solana-pay-1.2.0.tgz",
    "@solana/react": "^8.5.0",
    "@solana/rpc-subscriptions-api": "^8.6.0",
    "@solana/rpc-subscriptions-spec": "^8.6.0",
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.7",
    "swr": "^2.5.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@solana/surfpool": "^1.7.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@wallet-standard/wallet": "^1.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.9.0"
}
